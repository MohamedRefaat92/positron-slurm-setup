# ~/.ssh/config for Positron on HPC clusters.
# Copy the blocks you need into your ~/.ssh/config and fill in your usernames.

# Defaults for every host
Host *
    ServerAliveInterval 60          # keep idle connections alive
    ServerAliveCountMax 3
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain       # so the next line doesn't break ssh on Linux
    UseKeychain yes                 # macOS: keep the key's passphrase in Keychain
    IdentityFile ~/.ssh/id_ed25519

# BMRC login node (2FA). Log in once in a terminal (ssh bmrc_cluster);
# Positron and later ssh commands reuse that connection.
Host bmrc_cluster
    HostName cluster1.bmrc.ox.ac.uk
    User YOUR_BMRC_USERNAME         # e.g. abc123
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist yes

# BMRC compute node: your own SSH server running in a Slurm job (see remote/).
# Reads "<node> <port>" from the file the job writes, then tunnels there via the login node.
Host bmrc_compute
    User YOUR_BMRC_USERNAME
    HostKeyAlias bmrc_compute
    ProxyCommand bash -c 'read n p < <(ssh -n bmrc_cluster cat .ssh/userd/current_node); exec ssh -W $n:$p bmrc_cluster'

# A cluster with key-only login (no 2FA): no ControlMaster needed.
Host ludwig_cluster
    HostName YOUR_LUDWIG_HOST       # IP address or host name
    User YOUR_LUDWIG_USERNAME
