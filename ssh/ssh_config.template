# ── Hypothetical: AWS ParallelCluster / cloud HPC ────────────────────────────
# Cloud instances use key-only auth. Optionally use a dedicated key.
# Host aws_hpc
#     HostName ec2-XX-XX-XX-XX.compute-1.amazonaws.com
#     User ec2-user
#     IdentityFile ~/.ssh/aws_hpc_key     # generate with: ssh-keygen -t ed25519 -f ~/.ssh/aws_hpc_key

# ── Hypothetical: internal cluster behind a bastion / jump host ───────────────
# ProxyJump tunnels the connection through a public-facing node.
# Host internal_hpc
#     HostName 10.0.1.50
#     User YOUR_USERNAME
#     ProxyJump bastion.example.com

