# ~/.ssh/config — template for Positron + HPC clusters
# Copy relevant blocks into your actual ~/.ssh/config.
# Replace USER, HOSTNAME, and key paths with your own values.
# ---------------------------------------------------------------------------

# ── Global defaults ──────────────────────────────────────────────────────────
Host *
    ServerAliveInterval 60      # keepalive ping every 60 s
    ServerAliveCountMax 3       # drop connection after 3 missed pings (~3 min)
    AddKeysToAgent yes          # add key to ssh-agent on first use
    UseKeychain yes             # macOS: store passphrase in Keychain (remove on Linux)
    IdentityFile ~/.ssh/id_ed25519

# ── BMRC cluster (Oxford) — 2FA site ─────────────────────────────────────────
# Positron uses BatchMode=yes and cannot prompt for 2FA interactively.
# ControlMaster keeps an authenticated socket open; Positron reuses it.
#
# Workflow:
#   1. Open any terminal → ssh bmrc_cluster → complete 2FA
#   2. Connect from Positron — socket is reused, no auth prompt
Host bmrc_cluster
    HostName cluster1.bmrc.ox.ac.uk
    User YOUR_BMRC_USERNAME           # e.g. abc123
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist yes

# BMRC compute node, reached through the login node. On the node, a Slurm job
# runs your own SSH server and writes where it is ("<node> <port>") to
# ~/.ssh/userd/current_node; this ProxyCommand reads that file and tunnels there.
# No HostName: the node changes with every job. HostKeyAlias keeps one known_hosts
# entry for all of them (the server's key is the same on every node).
# Remote side: remote/README.md. Start a session: remote/positron-compute start
Host bmrc_compute
    User YOUR_BMRC_USERNAME           # e.g. abc123
    HostKeyAlias bmrc_compute
    ProxyCommand bash -c 'read -r n p < <(ssh -n bmrc_cluster cat .ssh/userd/current_node 2>/dev/null); [ -n "$p" ] || { echo "No Positron session is running on the cluster. Start one with: positron-compute start" >&2; exit 1; }; exec ssh -W "$n:$p" bmrc_cluster'

# ── Ludwig cluster — key-only auth ───────────────────────────────────────────
# Key auth means Positron's BatchMode=yes works directly — no ControlMaster needed.
Host ludwig_cluster
    HostName YOUR_LUDWIG_HOST         # IP address or host name, e.g. 192.0.2.10
    User YOUR_LUDWIG_USERNAME         # e.g. jdoe

# ── Hypothetical: university HPC with password + OTP ─────────────────────────
# Same ControlMaster pattern as BMRC for any 2FA / password-protected site.
