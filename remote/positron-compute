#!/usr/bin/env bash
# positron-compute — start, check and stop your Positron session on a compute node,
# from your laptop.
#
# Usage:
#   positron-compute setup                   one-time: copy the scripts to the cluster and set up
#   positron-compute start [sbatch options]  submit the job and wait until you can connect
#   positron-compute status                  is a session running? where? how long is left?
#   positron-compute open [folder]           open a folder on the compute node in Positron
#   positron-compute log                     show the end of the current job's log
#   positron-compute stop                    end the session (cancel the job)
#
# Examples:
#   positron-compute start                                  # defaults from the job script
#   positron-compute start -c 8 --mem=64G -t 12:00:00       # more CPUs, memory and time
#   positron-compute start -p long -t 3-00:00:00            # a 3-day session on "long"
#   positron-compute open /well/mylab/users/abc123/projects/myproject
#
# Settings: the names of your hosts in ~/.ssh/config. Change the defaults here,
# or set them for one command, e.g.  PC_LOGIN=other_cluster positron-compute status
# ---------------------------------------------------------------------------

set -euo pipefail

LOGIN="${PC_LOGIN:-bmrc_cluster}"      # login-node host in ~/.ssh/config
COMPUTE="${PC_COMPUTE:-bmrc_compute}"  # compute-node host in ~/.ssh/config
JOB_NAME="${PC_JOB:-positron}"         # must match --job-name in the job script
# shellcheck disable=SC2088  # the ~ is meant to expand on the cluster
REMOTE_DIR='~/.ssh/userd'              # on the cluster; expanded there, not here

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

say() { printf '%s\n' "$*"; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

# Run a command on the login node. BatchMode: never stop to ask for a password,
# fail instead (on 2FA clusters the open terminal session is what logs us in).
on_login() { ssh -o BatchMode=yes -o ConnectTimeout=20 "$LOGIN" "$@"; }

check_login() {
    if ! on_login true 2>/dev/null; then
        say "Can't reach $LOGIN without a password or 2FA prompt."
        say "  - On a 2FA cluster (e.g. BMRC): open a terminal, run  ssh $LOGIN  and log in;"
        say "    keep it open (or let ControlPersist keep the connection), then try again."
        say "  - Check that you're on the network the cluster requires (e.g. the university VPN)."
        exit 1
    fi
}

# Prints "<jobid> <state> <node> <time-left> <reason>" for each of your session jobs.
session_jobs() {
    on_login "squeue -h -u \$USER -n $JOB_NAME -o '%i %T %N %L %r'"
}

cmd_setup() {
    local f
    for f in setup_userd.sh positron_userd.sbatch; do
        [[ -f "$HERE/$f" ]] || die "$HERE/$f not found (run this script from the repository)."
    done
    check_login
    say "Copying the scripts to $LOGIN:$REMOTE_DIR/ …"
    on_login "mkdir -p $REMOTE_DIR && chmod 700 ~/.ssh $REMOTE_DIR"
    scp -q -o BatchMode=yes "$HERE/setup_userd.sh" "$HERE/positron_userd.sbatch" "$LOGIN:.ssh/userd/"
    say "Running the setup on the cluster …"
    say ""
    on_login "bash $REMOTE_DIR/setup_userd.sh"
}

cmd_start() {
    check_login
    local running
    running="$(session_jobs)"
    if [[ -n "$running" ]]; then
        say "A session is already running or queued:"
        say "  $running"
        say "Connect to it, or end it first with:  positron-compute stop"
        exit 1
    fi

    local args="" a
    for a in "$@"; do args="$args $(printf '%q' "$a")"; done
    local jobid
    jobid="$(on_login "cd $REMOTE_DIR/logs && sbatch --parsable$args ../positron_userd.sbatch")" \
        || die "sbatch refused the job (see the message above)."
    jobid="${jobid%%;*}"
    say "Submitted job $jobid. Waiting for it to start (Ctrl-C stops waiting; the job keeps going) …"

    local last="" line state node reason entry
    while true; do
        line="$(on_login "squeue -h -j $jobid -o '%T %r %N'" 2>/dev/null || true)"
        if [[ -z "$line" ]]; then
            say "Job $jobid is no longer in the queue. Its log:"
            on_login "tail -n 20 $REMOTE_DIR/logs/positron_$jobid.log" 2>/dev/null || true
            exit 1
        fi
        read -r state reason node <<< "$line"   # node is empty while pending
        if [[ "$state" == "RUNNING" ]]; then
            entry="$(on_login "cat $REMOTE_DIR/current_node 2>/dev/null" || true)"
            if [[ "${entry%% *}" == "$node" ]]; then
                break
            fi
            [[ "$last" == "starting" ]] || say "  running on $node, starting the server …"
            last="starting"
        else
            [[ "$last" == "$state $reason" ]] || say "  $state ($reason)"
            last="$state $reason"
        fi
        sleep 5
    done

    # accept-new: trust the server's key the first time, refuse if it ever changes.
    if ssh -o BatchMode=yes -o ConnectTimeout=30 -o StrictHostKeyChecking=accept-new "$COMPUTE" true 2>/dev/null; then
        say ""
        say "Ready: job $jobid on $node."
        say "In Positron: Remote Explorer → $COMPUTE → Connect (or: positron-compute open <folder>)."
        say "When you're done:  positron-compute stop"
    else
        say "The job is running on $node, but  ssh $COMPUTE  failed. Try it yourself for the error:"
        say "  ssh $COMPUTE hostname"
        say "and see the job's log with:  positron-compute log"
        exit 1
    fi
}

cmd_status() {
    check_login
    local jobs entry
    jobs="$(session_jobs)"
    if [[ -z "$jobs" ]]; then
        say "No session running. Start one with:  positron-compute start"
        return
    fi
    say "JOBID STATE NODE TIME-LEFT REASON"
    say "$jobs"
    entry="$(on_login "cat $REMOTE_DIR/current_node 2>/dev/null" || true)"
    [[ -n "$entry" ]] && say "Server address (node port): $entry"
    if [[ "$(printf '%s\n' "$jobs" | wc -l)" -gt 1 ]]; then
        say "Note: more than one session job. Only the newest one is reachable; cancel the others."
    fi
}

cmd_open() {
    local folder="${1:-}"
    command -v positron > /dev/null \
        || die "the 'positron' command isn't installed. In Positron: Command Palette → \"Shell Command: Install 'positron' command in PATH\"."
    if [[ -z "$folder" ]]; then
        positron --remote "ssh-remote+$COMPUTE"
    else
        [[ "$folder" == /* ]] || die "give the folder's full path on the cluster (starting with /)."
        positron --folder-uri "vscode-remote://ssh-remote+$COMPUTE$folder"
    fi
}

cmd_log() {
    check_login
    local jobid
    jobid="$(session_jobs | awk 'NR==1 {print $1}')"
    if [[ -z "$jobid" ]]; then
        say "No session running; showing the most recent log."
        on_login "f=\$(ls -t $REMOTE_DIR/logs/positron_*.log 2>/dev/null | head -1); [ -n \"\$f\" ] && echo \"== \$f\" && tail -n 30 \"\$f\""
    else
        on_login "tail -n 30 $REMOTE_DIR/logs/positron_$jobid.log"
    fi
}

cmd_stop() {
    check_login
    local jobs
    jobs="$(session_jobs)"
    if [[ -z "$jobs" ]]; then
        say "No session running."
        return
    fi
    on_login "scancel -u \$USER -n $JOB_NAME"
    say "Cancelled: $(printf '%s\n' "$jobs" | awk '{print $1}' | tr '\n' ' ')"
    say "(Positron will show the connection as lost; close that window.)"
}

case "${1:-}" in
    setup)  shift; cmd_setup "$@" ;;
    start)  shift; cmd_start "$@" ;;
    status) shift; cmd_status "$@" ;;
    open)   shift; cmd_open "$@" ;;
    log)    shift; cmd_log "$@" ;;
    stop)   shift; cmd_stop "$@" ;;
    *)      sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
